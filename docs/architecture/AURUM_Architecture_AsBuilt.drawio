<mxfile host="app.diagrams.net" agent="claude-code" version="27.0.9" type="device"><diagram id="aurum-arch" name="AURUM Architecture"><mxGraphModel dx="2400" dy="1600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AURUM — Data Platform Architecture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px;color:#607D8B'&gt;as built · Sep 2026 · equities (S&amp;P 500), free data sources, decisions emitted never auto-traded&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2300" height="70" as="geometry"/></mxCell><mxCell id="srcgrp" value="EXTERNAL SOURCES" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="940" as="geometry"/></mxCell><mxCell id="secbox" value="&lt;b&gt;SEC EDGAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 10-K / 10-Q filings&lt;br&gt;• XBRL company facts&lt;br&gt;• 6 statement feeds&lt;br&gt;• 10 req/s cap, honest UA&lt;br&gt;• full_load + truncate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="210" height="190" as="geometry"/></mxCell><mxCell id="yahooico" value="" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.yahoo_2;fillColor=#6001D2;strokeColor=none" vertex="1" parent="1"><mxGeometry x="150" y="470" width="80" height="47" as="geometry"/></mxCell><mxCell id="yahoobox" value="&lt;b&gt;Yahoo! Finance&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Daily OHLCV&lt;br&gt;• 503 S&amp;P 500 symbols&lt;br&gt;• 2000 → today&lt;br&gt;• watermarked incremental&lt;br&gt;• batch_size = memory knob" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="540" width="210" height="200" as="geometry"/></mxCell><mxCell id="pyico" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/carbon-icons/1/Logo_Python.svg" vertex="1" parent="1"><mxGeometry x="100" y="800" width="48" height="48" as="geometry"/></mxCell><mxCell id="ingbox" value="&lt;b&gt;src/ingestion&lt;/b&gt;&lt;br&gt;config-driven framework&lt;br&gt;&lt;br&gt;• YAML fully specifies a run&lt;br&gt;• registry + factory, no wiring&lt;br&gt;• watermark incremental&lt;br&gt;• staleness gate (min_refresh_gap_days)&lt;br&gt;• chunked read → chunked write" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="860" width="210" height="230" as="geometry"/></mxCell><mxCell id="aws" value="AWS Account" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="1990" height="1140" as="geometry"/></mxCell><mxCell id="orchgrp" value="ORCHESTRATION" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="520" height="700" as="geometry"/></mxCell><mxCell id="sched" value="EventBridge&lt;br&gt;Scheduler" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.eventbridge_scheduler;" vertex="1" parent="1"><mxGeometry x="430" y="275" width="70" height="70" as="geometry"/></mxCell><mxCell id="schednote" value="3 cron rules (UTC)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="200" height="40" as="geometry"/></mxCell><mxCell id="sfn1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="480" height="130" as="geometry"/></mxCell><mxCell id="sfn1i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="438" y="435" width="58" height="58" as="geometry"/></mxCell><mxCell id="sfn1t" value="&lt;b&gt;aurum-daily-market&lt;/b&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;cron(30 22 ? * MON-FRI *)&lt;/font&gt;&lt;br&gt;ingest-market → dbt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="506" y="415" width="380" height="100" as="geometry"/></mxCell><mxCell id="sfn2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="555" width="480" height="150" as="geometry"/></mxCell><mxCell id="sfn2i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="438" y="600" width="58" height="58" as="geometry"/></mxCell><mxCell id="sfn2t" value="&lt;b&gt;aurum-semimonthly-edgar&lt;/b&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;cron(0 6 1,15 * ? *)&lt;/font&gt;&lt;br&gt;ingest-market → ingest-edgar → dbt&lt;br&gt;&lt;font color='#78909C'&gt;carries its own dbt state — fires on weekends too&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="506" y="570" width="380" height="120" as="geometry"/></mxCell><mxCell id="sfn3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="480" height="130" as="geometry"/></mxCell><mxCell id="sfn3i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="438" y="765" width="58" height="58" as="geometry"/></mxCell><mxCell id="sfn3t" value="&lt;b&gt;aurum-monthly-train&lt;/b&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;cron(0 12 1 * ? *)&lt;/font&gt;&lt;br&gt;train&lt;br&gt;&lt;font color='#78909C'&gt;separate state: dbt failure never reaches training&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="506" y="745" width="380" height="110" as="geometry"/></mxCell><mxCell id="cmpgrp" value="COMPUTE — ECS FARGATE" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="440" height="700" as="geometry"/></mxCell><mxCell id="ecr" value="ECR&lt;br&gt;aurum:&lt;short-sha&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="64" height="64" as="geometry"/></mxCell><mxCell id="dockico" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Docker.svg" vertex="1" parent="1"><mxGeometry x="1120" y="280" width="54" height="54" as="geometry"/></mxCell><mxCell id="ecrnote" value="one image → four task&lt;br&gt;definitions; each command&lt;br&gt;is the whole workflow&lt;br&gt;(sh -c &quot;a &amp;&amp; b &amp;&amp; c&quot;)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="275" width="200" height="70" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;aurum-ingest-market&lt;/b&gt;&lt;br&gt;Yahoo OHLCV → landing&lt;br&gt;&lt;font color='#78909C'&gt;sized for daily increments&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="390" width="390" height="90" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;aurum-ingest-edgar&lt;/b&gt;&lt;br&gt;truncate + load 6 configs&lt;br&gt;&lt;font color='#78909C'&gt;per-config, gated by freshness&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="505" width="390" height="90" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;aurum-dbt&lt;/b&gt;&lt;br&gt;dbt build — models + 237 tests&lt;br&gt;&lt;font color='#78909C'&gt;runs after every ingest&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="620" width="390" height="90" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;aurum-train&lt;/b&gt;&lt;br&gt;LightGBM train → models/&lt;br&gt;&lt;font color='#78909C'&gt;AURUM_NUM_THREADS = vCPUs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="735" width="390" height="90" as="geometry"/></mxCell><mxCell id="syncnote" value="every state is &lt;b&gt;ecs:runTask.sync&lt;/b&gt; — non-zero container exit fails the execution" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="985" y="845" width="390" height="50" as="geometry"/></mxCell><mxCell id="rdsgrp" value="" style="rounded=1;arcSize=3;html=1;fillColor=#FAFAFA;strokeColor=#C925D1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1450" y="230" width="620" height="700" as="geometry"/></mxCell><mxCell id="rdsi" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1480" y="260" width="56" height="56" as="geometry"/></mxCell><mxCell id="pgico" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/databases/1/PostgreSQL.svg" vertex="1" parent="1"><mxGeometry x="1560" y="258" width="46" height="60" as="geometry"/></mxCell><mxCell id="rdslbl" value="&lt;b&gt;RDS PostgreSQL — aurum&lt;/b&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;medallion built on Postgres, not Snowflake&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="262" width="300" height="50" as="geometry"/></mxCell><mxCell id="dbtico" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="1990" y="258" width="52" height="52" as="geometry"/></mxCell><mxCell id="bronze" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;&lt;font color='#78909C'&gt;landing mirrors&lt;/font&gt;&lt;br&gt;&lt;br&gt;• 8 br_* models&lt;br&gt;• Yahoo OHLCV&lt;br&gt;• 6 EDGAR statements&lt;br&gt;• company_meta&lt;br&gt;&lt;br&gt;&lt;font color='#78909C'&gt;uppercase cols,&lt;br&gt;md5 primary_key&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE9D6;strokeColor=#D98C3F;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1478" y="350" width="182" height="540" as="geometry"/></mxCell><mxCell id="silver" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;&lt;font color='#78909C'&gt;typed + engineered&lt;/font&gt;&lt;br&gt;&lt;br&gt;• 3 stg_* models&lt;br&gt;• 5 int_* feature models&lt;br&gt;• point-in-time lag&lt;br&gt;• incremental lookback&lt;br&gt;&lt;br&gt;&lt;font color='#78909C'&gt;EDGAR dedup keeps latest&lt;br&gt;filed_date per&lt;br&gt;(cik, metric, period_end)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DDE3E8;strokeColor=#7C8B99;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1678" y="350" width="182" height="540" as="geometry"/></mxCell><mxCell id="gold" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;&lt;font color='#78909C'&gt;ML-ready marts&lt;/font&gt;&lt;br&gt;&lt;br&gt;• 4 mart_* models&lt;br&gt;• gold.mart_features&lt;br&gt;  ~2.9M rows, 503 symbols&lt;br&gt;• cross-sectional transform&lt;br&gt;• fwd_ret_5d_excess target&lt;br&gt;&lt;br&gt;&lt;font color='#78909C'&gt;ML + MCP read only&lt;br&gt;from GOLD&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE3A3;strokeColor=#D6A419;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1878" y="350" width="182" height="540" as="geometry"/></mxCell><mxCell id="seeds" value="3 seeds: company_meta · concept_map · selected_features" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1478" y="895" width="582" height="25" as="geometry"/></mxCell><mxCell id="opsgrp" value="OBSERVABILITY &amp; STATE" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="2110" y="230" width="220" height="700" as="geometry"/></mxCell><mxCell id="sns" value="SNS&lt;br&gt;aurum-alerts" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="2170" y="290" width="64" height="64" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;Logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudwatch_logs;" vertex="1" parent="1"><mxGeometry x="2165" y="445" width="72" height="54" as="geometry"/></mxCell><mxCell id="s3" value="S3&lt;br&gt;terraform state&lt;br&gt;&lt;font color='#78909C'&gt;use_lockfile&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2170" y="590" width="64" height="64" as="geometry"/></mxCell><mxCell id="opsnote" value="failures publish to SNS&lt;br&gt;&lt;b&gt;and&lt;/b&gt; end the execution red" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2125" y="760" width="190" height="50" as="geometry"/></mxCell><mxCell id="mdlgrp" value="MODELING — src/modeling (inside the train task)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="960" y="960" width="1370" height="290" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Training&lt;/b&gt;&lt;br&gt;&lt;br&gt;• LightGBM regression&lt;br&gt;• purged walk-forward CV&lt;br&gt;• embargo — naive fold_id ≤ k leaks&lt;br&gt;• hand-specified grid" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="1000" width="330" height="220" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Feature selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;• SHAP on holdout folds&lt;br&gt;• writes selected_features.csv&lt;br&gt;• narrowed-vs-full compare gate&lt;br&gt;  (holdout ICIR + decile spread)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="1000" width="330" height="220" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Backtest&lt;/b&gt;&lt;br&gt;&lt;br&gt;• overlapping tranches&lt;br&gt;• cost sweep → break-even bps&lt;br&gt;• factor attribution&lt;br&gt;• randomization / signal-lag /&lt;br&gt;  deflated Sharpe checks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1685" y="1000" width="330" height="220" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;flat files under&lt;br&gt;models/&lt;version&gt;/&lt;br&gt;&lt;br&gt;• model.txt&lt;br&gt;• metrics.json&lt;br&gt;• report.html&lt;br&gt;• two-sided promotion gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66A36B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2035" y="1000" width="270" height="220" as="geometry"/></mxCell><mxCell id="cigrp" value="CI / CD — GitHub Actions" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90A4AE;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="2300" height="180" as="geometry"/></mxCell><mxCell id="ghico" value="" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.github" vertex="1" parent="1"><mxGeometry x="105" y="1385" width="68" height="68" as="geometry"/></mxCell><mxCell id="ci1" value="&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;ruff · pytest (95 tests) · SonarCloud&lt;br&gt;&lt;font color='#78909C'&gt;uv sy